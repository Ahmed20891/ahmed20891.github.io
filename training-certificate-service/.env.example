# ─── Jira Cloud (same values as the OCC service) ──────────────────────────────
JIRA_BASE_URL=https://alsalamahospital.atlassian.net
JIRA_EMAIL=ahmed.gouda@alsalamahospital.com
JIRA_API_TOKEN=your-api-token-here

# ─── Branding ─────────────────────────────────────────────────────────────────
HOSPITAL_NAME=Al Salama Hospital

# ─── Chrome (PDF engine) ──────────────────────────────────────────────────────
PUPPETEER_EXECUTABLE_PATH=C:\ProgramData\puppeteer\chrome\win64-…\chrome.exe

# ─── Service ──────────────────────────────────────────────────────────────────
CERT_PORT=3004
CERT_BIND=127.0.0.1
# CERT_API_KEY=set-a-long-random-string-if-you-expose-this-beyond-localhost
CERT_POLL_INTERVAL_MINUTES=5
# On startup, look this far back so tickets that cleared while the service was
# down still get their certificate (duplicates are prevented by the tracker)
CERT_STARTUP_LOOKBACK_HOURS=24

# ─── Trigger (EXACT Jira names — confirm these before going live) ─────────────
CERT_PROJECT_KEY=ASAC
CERT_STATUS=Clearance
CERT_REQUEST_TYPE=Trainee Requests

# ─── Certificate custom fields ────────────────────────────────────────────────
CF_TRAINEE_NAME=customfield_13434
CF_TRAINEE_ID=customfield_13457
CF_INSTITUTION=customfield_13438
CF_PROGRAM=customfield_13451
CF_DEPARTMENT=customfield_10074
# Optional — leave blank to hide the training period line on the certificate
CF_START_DATE=
CF_END_DATE=

# ─── Signatories printed on the certificate ───────────────────────────────────
CERT_SIGNATORY_1_NAME=
CERT_SIGNATORY_1_TITLE=Training & Academic Affairs
CERT_SIGNATORY_2_NAME=
CERT_SIGNATORY_2_TITLE=Medical Director
# Optional round stamp/seal image, e.g. assets/seal.png
CERT_SEAL_PATH=

# ─── Accreditation marks ──────────────────────────────────────────────────────
# Drop the approved artwork in assets/ as jci-logo.png and cbahi-logo.png and
# the strip appears automatically. Set these only to override the location.
CERT_JCI_LOGO_PATH=
CERT_CBAHI_LOGO_PATH=
CERT_ACCREDITATION_LABEL=Accredited by
# Printed height of each mark in mm (a round seal needs more than a wordmark)
CERT_JCI_HEIGHT_MM=13
CERT_CBAHI_HEIGHT_MM=10

# Bilingual select values such as "ICT قسم تقنية المعلومات" print as "ICT" on the
# English certificate. Set to false to print the Arabic half as well.
CERT_ENGLISH_ONLY_FIELDS=true

# ─── Jira write-back ──────────────────────────────────────────────────────────
CERT_ATTACH_TO_JIRA=true
CERT_COMMENT_ON_JIRA=true

# ─── Email ────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.mcam.local
SMTP_PORT=25
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@alsalamahospital.com
NOTIFY_EMAIL=Ahmed.Gouda@alsalamahospital.com
# Fixed training-team CC (comma separated)
CERT_CC_EMAILS=
