# ── Add to the certificate service's .env ─────────────────────────────────────
# (JIRA_BASE_URL / JIRA_EMAIL / JIRA_API_TOKEN are reused from the existing .env)

# Moyasar — from the finance team. sk_test_… first, sk_live_… after sign-off.
MOYASAR_SECRET_KEY=
# The "Secret Token" typed into Moyasar Dashboard → Settings → Webhooks.
# Leave empty to run on polling only (no public URL needed).
MOYASAR_WEBHOOK_SECRET=

# Start with a dry run: logs what it WOULD do, creates nothing, transitions nothing.
PAY_DRY_RUN=true
PAY_POLL_INTERVAL_MINUTES=2
PAY_INVOICE_EXPIRY_DAYS=7

# Trigger (defaults shown — checked against ASAC-2)
PAY_PROJECT_KEY=ASAC
PAY_REQUEST_TYPE=Trainee Requests
PAY_STATUS_WAITING=Waiting for Payment
PAY_STATUS_PAID=Paid
PAY_STATUS_FAILED=Failed Payment

# Fields
PAY_CF_TOTAL_COST=customfield_11636
PAY_CF_TRAINEE_NAME=customfield_13434
PAY_CF_TRAINEE_ID=customfield_13457
# Optional URL field to also store the payment link in
PAY_CF_INVOICE_URL=

# transition = failed attempt moves the ticket to "Failed Payment"
# comment    = only comment; the trainee can retry with the same link
PAY_ON_FAILED=transition
# Post the payment link as a public comment (the trainee gets the JSM email)
PAY_PUBLIC_COMMENT=true

# Optional pages shown by Moyasar
PAY_SUCCESS_URL=
PAY_BACK_URL=

# x-api-key for /payments/poll-now and /payments/issue/:key (falls back to CERT_API_KEY)
PAY_API_KEY=
